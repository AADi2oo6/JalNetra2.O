# JalNetra 2.0 .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Environment & Secrets
.env
.env.local
.env.*.local
*.env

# SQLite databases
*.db
*.sqlite3

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
dist/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# JalNetra local data runtime files (preserve directories via .gitkeep)
data/database/*
!data/database/.gitkeep
data/water_bodies/*
!data/water_bodies/.gitkeep
data/scenes/*
!data/scenes/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/tiles/*
!data/tiles/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
